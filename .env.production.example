# Copy to .env.production and fill in. Never commit .env.production.
NEXT_PUBLIC_APP_URL=https://code.example.com
SITE_ADDRESS=code.example.com

# Local Postgres (docker compose --profile db). For Neon, skip POSTGRES_PASSWORD's use and set DATABASE_URL to the Neon URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://nullfuse:CHANGE_ME@postgres:5432/nullfuse

BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=

ENV_ENCRYPTION_KEY=

# Optional. Without it, runs stay queued. Needs the worker running.
# TRIGGER_SECRET_KEY=

# Screen recordings (not used yet): a private Cloudflare R2 bucket and a key limited to it
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional chat apps; see docs/connectors.md. Each appears once all its values are set.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
