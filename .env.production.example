# Copy to .env.production and fill in. Never commit .env.production.
NEXT_PUBLIC_APP_URL=https://code.example.com
SITE_ADDRESS=code.example.com

# Local Postgres (docker compose --profile db). For Neon, skip POSTGRES_PASSWORD's use and set DATABASE_URL to the Neon URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://nullfuse:CHANGE_ME@postgres:5432/nullfuse

BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=

ENV_ENCRYPTION_KEY=

# Optional. Without it, runs stay queued. Needs the worker running.
# TRIGGER_SECRET_KEY=
