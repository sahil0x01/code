# Copy to .env in this folder; `pnpm --filter @nullfuse/worker dev` reads it.
TRIGGER_PROJECT_REF=proj_replace_me
DATABASE_URL=postgres://nullfuse:nullfuse@localhost:5432/nullfuse
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
# The same key the web app uses, so project variables can be decrypted.
ENV_ENCRYPTION_KEY=
DEEPSEEK_API_KEY=
# RUN_AUTHOR_NAME=Prefill Code
# RUN_AUTHOR_EMAIL=code@prefill.invalid


# Sandboxes: docker (default, needs a Docker daemon), agent37 or daytona (both hosted)
# AGENT37_API_KEY=
# Only if the template names differ from the ones `agent37:templates` builds (see docs/agent37.md)
# AGENT37_TEMPLATE=
# AGENT37_BROWSER_TEMPLATE=
# SANDBOX_DRIVER=docker
# DAYTONA_API_KEY=
# The start of the snapshot name; a hash of the Dockerfile is added
# DAYTONA_SNAPSHOT=nullfuse-sandbox
# Sandbox network: "restricted" (default with Docker and Agent37) or "open" (default with Daytona,
# which needs tier 3 to accept rules per sandbox)
# SANDBOX_NETWORK=
# More domains restricted sandboxes may reach, such as your own package registry or a test API
# SANDBOX_ALLOW_DOMAINS=
# Limits (defaults shown)
# MAX_RUNNING_PER_USER=5
# RUN_MAX_DISK_MB=2048
# RUN_MAX_STEPS=
# RUN_MAX_TOKENS=
# RUN_MAX_COST_USD=1
# Auto-fix: automatic runs allowed in a row, and their spend per chat (see docs/auto-fix.md)
# AUTOFIX_MAX_RUNS=3
# AUTOFIX_MAX_COST_USD=2
# RUN_STALE_SECONDS=90
# RUN_MAX_ATTEMPTS=3
# Used when the chosen model keeps failing (a name from models.ts)
# FALLBACK_MODEL=
# Self-hosting only: allow users' model addresses on your own network (also set it for the web app)
# ALLOW_PRIVATE_MODEL_URLS=false

# Screen recordings (not used yet): a private Cloudflare R2 bucket and a key limited to it
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Where the web app is, so pull requests can link to recordings
# APP_URL=http://localhost:3000
# Replies to tasks sent from Discord and Telegram (see docs/connectors.md)
# DISCORD_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
